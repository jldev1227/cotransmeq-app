# Mapbox Configuration
# Obtén tu token en https://www.mapbox.com/
VITE_MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

# API Configuration
# Origen del backend, SIN `/api`: el cliente ya antepone `/api/` a cada ruta.
VITE_API_URL=http://127.0.0.1:4000
VITE_SOCKET_URL=http://127.0.0.1:4000

# Rastreo de errores (Sentry) — OPCIONAL. Sin DSN no se carga ni el SDK.
# Se leen en tiempo de ejecución ($env/dynamic): basta con ponerlas en el
# entorno del contenedor (en Proxmox, el runtime env del frontend), sin
# recompilar la imagen.
#   PUBLIC_SENTRY_DSN  — errores del navegador. Es público por diseño: un DSN
#                        solo sirve para ENVIAR eventos a ese proyecto.
#   SENTRY_DSN         — errores del servidor (SSR y rutas /api de SvelteKit).
PUBLIC_SENTRY_DSN=
PUBLIC_SENTRY_ENVIRONMENT=
SENTRY_DSN=
SENTRY_ENVIRONMENT=
